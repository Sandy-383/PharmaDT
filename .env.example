# Copy to .env and adjust. .env is gitignored; this file is the checked-in
# template so a clean checkout knows what it needs.

# ── Persistence ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://pharmadt:pharmadt@localhost:5432/pharmadt

# ── Simulation (Stage 3) ──────────────────────────────────────────────
# SIM_SEED drives every stochastic process. Two runs with the same seed must
# produce byte-identical event logs.
SIM_SEED=42
SIM_DAYS=365
# Start at 12 (1 manufacturer, 2 warehouses, 3 distributors, 6 pharmacies).
# FR-01 requires 50 — scale up only once the twin is stable at 12.
NUM_NODES=12
